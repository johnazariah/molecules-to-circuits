"html_id":"acknowledgements","implicit":true,"key":"MxrcJeCtv6"},{"type":"paragraph","position":{"start":{"line":156,"column":1},"end":{"line":157,"column":1}},"children":[{"type":"text","value":"This work grew out of research at the Centre for Quantum Software\nand Information at the University of Technology Sydney.","position":{"start":{"line":156,"column":1},"end":{"line":156,"column":1}},"key":"XvK1DCOKlF"}],"key":"OuZRFId3XO"},{"type":"paragraph","position":{"start":{"line":159,"column":1},"end":{"line":162,"column":1}},"children":[{"type":"text","value":"I am grateful to Dr Chris Ferrie for his patient guidance of my\nexploration, to Dr Guang Hao Low for sparking the journey, and to\nDr Stephen Jordan and Dr Helmut Katzgraber for their continued\nencouragement.","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"nr64jxY2Nw"}],"key":"rSnZE60T0Q"},{"type":"paragraph","position":{"start":{"line":164,"column":1},"end":{"line":164,"column":1}},"children":[{"type":"text","value":"And to my family, for bearing all my burdens.","position":{"start":{"line":164,"column":1},"end":{"line":164,"column":1}},"key":"ZiZqKZlwR1"}],"key":"lCvhnrwX3l"},{"type":"paragraph","position":{"start":{"line":166,"column":1},"end":{"line":166,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":166,"column":1},"end":{"line":166,"column":1}},"children":[{"type":"text","value":"Sydney, March 2026","position":{"start":{"line":166,"column":1},"end":{"line":166,"column":1}},"key":"Hu71NqNH7o"}],"key":"rRDCO23rjb"}],"key":"MQ3nTvmTAP"},{"type":"thematicBreak","position":{"start":{"line":168,"column":1},"end":{"line":168,"column":1}},"key":"hJmnNLGXpD"},{"type":"heading","depth":3,"position":{"start":{"line":170,"column":1},"end":{"line":170,"column":1}},"children":[{"type":"text","value":"About the Author","position":{"start":{"line":170,"column":1},"end":{"line":170,"column":1}},"key":"tah1T8rhb7"}],"identifier":"about-the-author","label":"About the Author","html_id":"about-the-author","implicit":true,"key":"BBh64i3rxB"},{"type":"paragraph","position":{"start":{"line":172,"column":1},"end":{"line":176,"column":1}},"children":[{"type":"text","value":"John S Azariah is a software engineer, language designer, and quantum\ncomputing researcher whose work sits at the intersection of chemistry,\ncomputation, and executable mathematics. He earned a BA in Computer\nScience and Chemistry from Dartmouth College, a combination that now\nfinds a natural expression in quantum simulation.","position":{"start":{"line":172,"column":1},"end":{"line":172,"column":1}},"key":"te0BW27hXg"}],"key":"t34IcASD7U"},{"type":"paragraph","position":{"start":{"line":178,"column":1},"end":{"line":185,"column":1}},"children":[{"type":"text","value":"Over more than three decades in professional software development, he\nhas worked through successive technology shifts including desktop\nsoftware, the internet, cloud computing, quantum programming, and AI.\nHis career has included roles on Microsoft Excel and Microsoft Project,\nearly SharePoint prototypes, Visual J#.NET, large-scale Azure systems,\nand principal engineering work across Azure Batch, Azure Kubernetes\nService, and AI systems in APAC. He was also compiler lead and one of\nthe language designers behind Microsoft Q#.","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"iSZTTRJcOm"}],"key":"B4x6Q74yl7"},{"type":"paragraph","position":{"start":{"line":187,"column":1},"end":{"line":191,"column":1}},"children":[{"type":"text","value":"Alongside industry work, he has maintained a longstanding interest in\nfunctional programming, scientific computing, and software craft. He is\ncurrently a Principal AI SME at Microsoft and is pursuing a PhD in\nQuantum Computing at the University of Technology Sydney under\nDr. Chris Ferrie.","position":{"start":{"line":187,"column":1},"end":{"line":187,"column":1}},"key":"V5UnONErxo"}],"key":"l2Q1vebQ2z"}],"key":"X4lZPSozBx"}],"key":"bT48oBBN2Z"},"references":{"cite":{"order":[],"data":{}}}}